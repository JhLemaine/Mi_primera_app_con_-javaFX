<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="-Infinity"
      maxWidth="-Infinity"
      minHeight="-Infinity"
      minWidth="-Infinity"
      prefHeight="643.0"
      prefWidth="1093.0"
      xmlns="http://javafx.com/javafx/21.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.demo.controller.ContactoController">

    <children>

        <Label alignment="CENTER"
               prefHeight="60.0"
               prefWidth="193.0"
               text="Agenda de Contactos" />

        <HBox alignment="CENTER"
              prefHeight="152.0"
              prefWidth="1093.0"
              styleClass="green">

            <children>
                <TextField fx:id="txtNombre"
                           prefHeight="53.0"
                           prefWidth="192.0"
                           promptText="Nombre" />

                <TextField fx:id="txtCorreo"
                           prefHeight="52.0"
                           prefWidth="195.0"
                           promptText="Correo" />

                <TextField fx:id="txtNumero"
                           prefHeight="52.0"
                           prefWidth="196.0"
                           promptText="Numero" />

                <TextField fx:id="txtComentario"
                           prefHeight="51.0"
                           prefWidth="206.0"
                           promptText="Comentario" />
            </children>

            <opaqueInsets>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </opaqueInsets>

        </HBox>

        <HBox alignment="CENTER"
              prefHeight="100.0"
              prefWidth="200.0">

            <children>
                <Button alignment="CENTER"
                        onAction="#agregarContacto"
                        contentDisplay="RIGHT"
                        mnemonicParsing="false"
                        prefHeight="43.0"
                        prefWidth="98.0"
                        text="Agregar" />

                <Button alignment="CENTER"
                        onAction="#eliminarContacto"
                        contentDisplay="RIGHT"
                        mnemonicParsing="false"
                        prefHeight="43.0"
                        prefWidth="114.0"
                        text="Eliminar" />

                <Button alignment="CENTER"
                        onAction="#actualizarContacto"
                        contentDisplay="RIGHT"
                        mnemonicParsing="false"
                        prefHeight="43.0"
                        prefWidth="115.0"
                        text="Actualizar" />

                <Button alignment="CENTER"
                        onAction="#limpiarCampos"
                        contentDisplay="RIGHT"
                        mnemonicParsing="false"
                        prefHeight="43.0"
                        prefWidth="293.0"
                        text="Limpiar Campos" />
            </children>
        </HBox>

        <!-- Se agregó el fx:id a la tabla y a sus columnas correspondientes -->
        <TableView fx:id="tablaAgenda" prefHeight="319.0" prefWidth="1093.0">
            <columns>
                <TableColumn fx:id="colNombre" prefWidth="400.0" text="Nombre" />
                <TableColumn fx:id="colCorreo" prefWidth="341.0" text="Correo" />
                <TableColumn fx:id="colNumero" minWidth="0.0" prefWidth="91.0" text="Número" />
                <TableColumn fx:id="colComentario" prefWidth="260.0" text="Comentario" />
            </columns>
        </TableView>

    </children>
</VBox>